# ---------------------------------------------------------------------------
# Confidential source material - MUST NEVER be committed.
#
# The reference prospectus contains real people's names, home addresses, direct
# phone numbers, email addresses and a photographed PAN card. Publishing it
# would leak exactly the data this tool exists to protect.
# ---------------------------------------------------------------------------
input/*.docx
input/*.pdf
output/
!input/.gitkeep

# The synthetic fixture is safe to commit: it is entirely invented and is
# regenerated by scripts/make_synthetic_docx.py.
!input/synthetic_sample.docx

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
